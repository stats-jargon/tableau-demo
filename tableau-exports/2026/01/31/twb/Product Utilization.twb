      <aliases enabled='yes' />
      <column caption='Measure Names' datatype='string' name='[:Measure Names]' role='dimension' type='nominal' />
      <column caption='Percent of total seats active ' datatype='real' default-format='p0%' name='[Calculation_1038079758055100416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Simple ratio calculaion to label percent of total chart with percentage of active seats&#13;&#10;&#13;&#10;COUNTD([Calculation_1422011593679265795])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([Calculation_747034597466587148])' />
      </column>
      <column caption='Number of active days' datatype='integer' default-format='N' name='[Calculation_1067071650202550272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// counts distinct dates in the data set to determine number of active days&#13;&#10;// no activity would equal a null date entry for this field&#13;&#10;// therefore this is a simple way to count active days &#13;&#10;&#13;&#10;COUNTD(DATE([createdAt (Activities)]))' />
        <desc>
          <formatted-text>
            <run>Calculates the number of days in the available data that a user has been active. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Active % Total' datatype='real' hidden='true' name='[Calculation_1068197570616365060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is an IF statement with ratio calculation&#13;&#10;// it checks for the fields that have been labels as active&#13;&#10;// then takes the distinct count of seat id i.e. active users &#13;&#10;// then divides by all users&#13;&#10;&#13;&#10;IF ATTR([Calculation_1230327132095434752]) = &apos;Active&apos; &#13;&#10;THEN COUNTD([seatId]) / TOTAL(COUNTD([seatId]))&#13;&#10;ELSE NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
        <desc>
          <formatted-text>
            <run>Calculates the percent of users that are active out of the total. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Seat active?' datatype='string' name='[Calculation_1230327132095434752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// This is an IF statement&#13;&#10;// checks the data for null entries for activity type&#13;&#10;// for records where there is an entry for activty type this can be categorised as activty&#13;&#10;&#13;&#10;&#13;&#10;IF {FIXED [seatId]:COUNTD([activityType])} &lt;1 &#13;&#10;THEN &apos;Innactive&apos; &#13;&#10;ELSE &apos;Active&apos; &#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>Determines if a user has been active or innactive. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Full Name' datatype='string' name='[Calculation_1230327132098691073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Simple calculation to combine the first and last name fields&#13;&#10;// creating a full name field&#13;&#10;&#13;&#10;[firstName] + &quot; &quot; + [lastName]' />
        <desc>
          <formatted-text>
            <run>A calculated field to bring together first and last names. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Number of active seats' datatype='integer' name='[Calculation_1422011593679265795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is an IF statement to isolate seats that are categorised as active and then count them&#13;&#10;&#13;&#10;IF [Calculation_1230327132095434752] = &apos;Active&apos; &#13;&#10;THEN [seatId]&#13;&#10;ELSE NULL&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>determines the number of seats that have been active. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Number of inactive seats' datatype='integer' name='[Calculation_1422011593684369412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// subtracts the number of seat with activity from all seats in the data set &#13;&#10;&#13;&#10;MAX({COUNTD([seatId])}) - COUNTD([seatId (Activities)])' />
        <desc>
          <formatted-text>
            <run>Calculates the number of seats that have been innactive over the time period. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Latest activity date' datatype='string' datatype-customized='true' name='[Calculation_26177182419017728]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// This is an IF statement with data type conversion&#13;&#10;// The IF statement firstly checks what the maximum or latest date of activity?&#13;&#10;// if the result is null then there is no activty for that individual &#13;&#10;// therefore their last activty must be before the data instance&#13;&#10;// if the result is not null a date is returned&#13;&#10;// as the null result is as string the date result has to be converted to string for the caculation to be vaild &#13;&#10; &#13;&#10;&#13;&#10;&#13;&#10;IF ISNULL(MAX([createdAt (Activities)]))&#13;&#10;THEN &apos;Prior to this data set&apos; &#13;&#10;&#13;&#10;ELSE STR(MAX([createdAt (Activities)]))&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>Queries the data for the most recent date of activity. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Number of inactive days' datatype='integer' name='[Calculation_26177182419832833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// to calculate the number of inactive days we need to know the number of days of data for each user&#13;&#10;// then subtract the number of active days of data&#13;&#10;// if there are no activty date entries then the number of days in the data set can be taken&#13;&#10;// the if statement fisrt checks for this null condition&#13;&#10;// else, allows for the calculation to go ahead&#13;&#10;&#13;&#10;IF ISNULL([Calculation_891431291648167936] - [Calculation_1067071650202550272])&#13;&#10;THEN SUM({[Calculation_891431291648167936]})&#13;&#10;ELSE (ZN([Calculation_891431291648167936]) - ZN([Calculation_1067071650202550272]))&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>Calculates the number of days in the data that a user was innactive. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Inactive longer than data instance?' datatype='string' name='[Calculation_685110132315906048]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_26177182419017728] = &apos;Prior to this data set&apos;&#13;&#10;THEN &quot;+&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Amount of Seats' datatype='integer' name='[Calculation_747034597466587148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Distict count of seat ids to determine how many &#13;&#10;&#13;&#10;{COUNTD([seatId])}' />
        <desc>
          <formatted-text>
            <run>How many seats are there? Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Number of days in time period' datatype='integer' name='[Calculation_891431291648167936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is a date difference calculation&#13;&#10;// here it counts the number of days between the minimum and maximum activty dates in the data set&#13;&#10;// since the result of this calculation if the min and max activity date were the same would be 0 &#13;&#10;// 1 day extra is added as this still counts as 1 day of activity&#13;&#10;&#13;&#10;DATEDIFF(&apos;day&apos;, MIN([createdAt (Activities)]), MAX([createdAt (Activities)]))+1' />
        <desc>
          <formatted-text>
            <run>calculates the time period of activity. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Days since last active' datatype='integer' name='[Calculation_891431291656912899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// this is an IF statement with some nested date difference calcualtions and null testing&#13;&#10;// firstly it checks if the result of calculating the difference in days between a max activity date and the max activty date of the whole data set is null&#13;&#10;// IF it is null then this is equal to the &quot;number of inactive days&quot; calculated field&#13;&#10;// IF not null then the result of the same date difference calculation is taken&#13;&#10;&#13;&#10;&#13;&#10;IF ISNULL(DATEDIFF(&apos;day&apos;, MAX([createdAt (Activities)]), MAX({MAX([createdAt (Activities)])})))&#13;&#10;&#13;&#10;THEN [Calculation_26177182419832833]&#13;&#10;&#13;&#10;ELSE DATEDIFF(&apos;day&apos;, MAX([createdAt (Activities)]), MAX({MAX([createdAt (Activities)])}))&#13;&#10;&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>Determines the number of days since a user was last active. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Max date in time period' datatype='date' datatype-customized='true' name='[Calculation_891431291664461828]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// returns the most recent activity date in the data&#13;&#10;&#13;&#10;DATE({MAX([createdAt (Activities)])})' />
        <desc>
          <formatted-text>
            <run>maxiumum activity date. Right click and select edit for more info</run>
          </formatted-text>
        </desc>
      </column>
