            <column caption='Seat active?' datatype='string' name='[Calculation_1230327132095434752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// This is an IF statement&#13;&#10;// checks the data for null entries for activity type&#13;&#10;// for records where there is an entry for activty type this can be categorised as activty&#13;&#10;&#13;&#10;&#13;&#10;IF {FIXED [seatId]:COUNTD([activityType])} &lt;1 &#13;&#10;THEN &apos;Innactive&apos; &#13;&#10;ELSE &apos;Active&apos; &#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>Determines if a user has been active or innactive. Right click and select edit for more info</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Total Amount of Seats' datatype='integer' name='[Calculation_747034597466587148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Distict count of seat ids to determine how many &#13;&#10;&#13;&#10;{COUNTD([seatId])}' />
              <desc>
